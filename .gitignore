# Secrets — never commit real keys
.env
service/.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Python virtual environments — any of the common names, anywhere in
# the repo (not just service/), so a venv created in a different spot
# still gets caught.
.venv/
venv/
rip/
env/
.venv*/
venv*/
ENV/

# Node / Next.js — node_modules and build output wherever they land,
# not just under frontend/, so a nested package or a future workspace
# doesn't need its own entry.
node_modules/
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
